# SearchOps local configuration
# Copy to .env — never commit real credentials.

# API
SEARCHOPS_ENV=local
SEARCHOPS_SECRET_KEY=change-me-in-any-shared-environment
SEARCHOPS_ACCESS_TOKEN_EXPIRE_MINUTES=720
SEARCHOPS_API_HOST=0.0.0.0
SEARCHOPS_API_PORT=8000

# Postgres (docker compose default)
DATABASE_URL=postgresql+asyncpg://searchops:searchops@localhost:5432/searchops

# SQLite fallback for tests / no-docker local
# DATABASE_URL=sqlite+aiosqlite:///./data/processed/searchops.db

REDIS_URL=redis://localhost:6379/0
CACHE_TTL_SECONDS=60

# Embeddings: mock | hashed | openai | gemini | huggingface
EMBEDDING_PROVIDER=hashed
EMBEDDING_DIM=384
OPENAI_API_KEY=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
GEMINI_API_KEY=
GEMINI_EMBEDDING_MODEL=text-embedding-004
HF_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Optional LLM for query understanding / LLM rerank
LLM_PROVIDER=none
OPENAI_CHAT_MODEL=gpt-4o-mini
GEMINI_CHAT_MODEL=gemini-2.0-flash

# Reranker: noop | heuristic | cross_encoder | llm
RERANKER=heuristic
HYBRID_ALPHA=0.6

# Demo seed
DEMO_SEED=true
DEMO_EMAIL=demo@searchops.dev
DEMO_PASSWORD=demo-password

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000
